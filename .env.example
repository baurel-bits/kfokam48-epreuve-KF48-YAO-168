# ==============================================================================
# ARCHITECTURE FULLSTACK - VARIABLES D'ENVIRONNEMENT D'EXEMPLE
# Copiez ce fichier en '.env' (ne pas commiter de secrets réels)
# ==============================================================================

# --- DATABASE (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/exam_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=exam_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- JWT AUTHENTICATION (Spring Boot) ---
# Secret HS256 hexadécimal 256 bits minimum
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- SPRING MAIL (SMTP) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- SEED DEFAULT ACCOUNTS ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!
USER_EMAIL=user@example.com
USER_PASSWORD=User1234!

# --- FRONTEND (Next.js) ---
# Uniquement les variables destinées au client (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8080
